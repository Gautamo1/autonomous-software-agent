{
  "mcpServers": {
    "filesystem": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${MCP_WORKSPACE_PATH}"
      ],
      "shell": true
      },
  "git": {
  "command": "uvx",
  "args": [
    "mcp-server-git",
    "--repository",
    "${MCP_WORKSPACE_PATH}"
  ]
    }
  }
}